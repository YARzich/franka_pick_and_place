{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/manipulation_perception/gpu-perception-evidence.schema.v1.json",
  "title": "GPU perception runtime evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "evidence_status",
    "run_token",
    "revision",
    "contract",
    "started_at",
    "finished_at",
    "observation_elapsed_sec",
    "claim_scope",
    "gpu_identity",
    "asset_digests",
    "correlated_samples",
    "terminal_pose",
    "diagnostics",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "gpu_perception_evidence"},
    "evidence_status": {"enum": ["pass", "fail"]},
    "run_token": {"type": "string", "minLength": 1},
    "revision": {"$ref": "#/$defs/revision"},
    "contract": {"$ref": "#/$defs/contract_identity"},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "observation_elapsed_sec": {"type": "number", "minimum": 0},
    "claim_scope": {"$ref": "#/$defs/claim_scope"},
    "gpu_identity": {
      "oneOf": [
        {"$ref": "#/$defs/gpu_identity"},
        {"type": "null"}
      ]
    },
    "asset_digests": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset_digest"}
    },
    "correlated_samples": {
      "type": "array",
      "items": {"$ref": "#/$defs/correlated_sample"}
    },
    "terminal_pose": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/topic_sample"},
            {"required": ["age_sec"]}
          ]
        },
        {"type": "null"}
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic_evidence"}
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence_status": {"const": "pass"}},
        "required": ["evidence_status"]
      },
      "then": {
        "properties": {
          "gpu_identity": {"$ref": "#/$defs/gpu_identity"},
          "asset_digests": {"minItems": 1},
          "correlated_samples": {"minItems": 1},
          "terminal_pose": {
            "allOf": [
              {"$ref": "#/$defs/topic_sample"},
              {"required": ["age_sec"]}
            ]
          },
          "diagnostics": {
            "minItems": 4,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/diagnostic_evidence"},
                {
                  "properties": {
                    "latest_source_sample": {"$ref": "#/$defs/topic_sample"}
                  }
                }
              ]
            }
          },
          "errors": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "source": {"const": "explicit_argument"}
      }
    },
    "contract_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "sha256"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_correlation", "accuracy", "replay"],
      "properties": {
        "runtime_correlation": {"const": true},
        "accuracy": {"const": false},
        "replay": {"const": false}
      }
    },
    "gpu_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "devices", "stdout_sha256"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"const": "/usr/bin/nvidia-smi"},
            {"const": "--query-gpu=name,uuid,driver_version,memory.total"},
            {"const": "--format=csv,noheader,nounits"}
          ]
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        },
        "stdout_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "asset_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "size_bytes", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "topic_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "topic",
        "message_type",
        "frame_id",
        "stamp_sec",
        "stamp_nanosec",
        "received_elapsed_sec",
        "serialized_size_bytes",
        "serialized_sha256",
        "content_count"
      ],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "pattern": "^/"},
        "message_type": {"type": "string", "minLength": 1},
        "frame_id": {"type": "string", "minLength": 1},
        "stamp_sec": {"type": "integer"},
        "stamp_nanosec": {"type": "integer", "minimum": 0, "maximum": 999999999},
        "received_elapsed_sec": {"type": "number", "minimum": 0},
        "serialized_size_bytes": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "serialized_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "content_count": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "age_sec": {"type": "number", "minimum": 0}
      }
    },
    "correlated_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "stamp_sec", "stamp_nanosec", "topics"],
      "properties": {
        "group": {"type": "string", "minLength": 1},
        "stamp_sec": {"type": "integer"},
        "stamp_nanosec": {"type": "integer", "minimum": 0, "maximum": 999999999},
        "topics": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/topic_sample"}
        }
      }
    },
    "source_correlation": {
      "oneOf": [
        {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{9}@.+$"},
        {"type": "null"}
      ]
    },
    "diagnostic_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_count",
        "processed_count",
        "output_count",
        "error_count",
        "drop_or_skip_count",
        "drop_or_skip_ratio",
        "worker_timeout_count",
        "worker_restart_count",
        "latency_sample_count",
        "processing_latency_p50_sec",
        "processing_latency_p95_sec",
        "processing_latency_max_sec",
        "last_success_age_sec",
        "last_success_source",
        "steady_uptime_sec"
      ],
      "properties": {
        "input_count": {"type": "integer", "minimum": 0},
        "processed_count": {"type": "integer", "minimum": 0},
        "output_count": {"type": "integer", "minimum": 0},
        "error_count": {"type": "integer", "minimum": 0},
        "drop_or_skip_count": {"type": "integer", "minimum": 0},
        "drop_or_skip_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "worker_timeout_count": {"type": "integer", "minimum": 0},
        "worker_restart_count": {"type": "integer", "minimum": 0},
        "latency_sample_count": {"type": "integer", "minimum": 0},
        "processing_latency_p50_sec": {"$ref": "#/$defs/optional_nonnegative"},
        "processing_latency_p95_sec": {"$ref": "#/$defs/optional_nonnegative"},
        "processing_latency_max_sec": {"$ref": "#/$defs/optional_nonnegative"},
        "last_success_age_sec": {"$ref": "#/$defs/optional_nonnegative"},
        "last_success_source": {"$ref": "#/$defs/source_correlation"},
        "steady_uptime_sec": {"type": "number", "minimum": 0}
      }
    },
    "optional_nonnegative": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "diagnostic_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_count",
        "processed_count",
        "output_count",
        "error_count",
        "drop_or_skip_count",
        "worker_timeout_count",
        "worker_restart_count",
        "latency_observation_count"
      ],
      "properties": {
        "input_count": {"type": "integer", "minimum": 0},
        "processed_count": {"type": "integer", "minimum": 0},
        "output_count": {"type": "integer", "minimum": 0},
        "error_count": {"type": "integer", "minimum": 0},
        "drop_or_skip_count": {"type": "integer", "minimum": 0},
        "worker_timeout_count": {"type": "integer", "minimum": 0},
        "worker_restart_count": {"type": "integer", "minimum": 0},
        "latency_observation_count": {"type": "integer", "minimum": 0}
      }
    },
    "diagnostic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "status_name",
        "source_topic_role",
        "latest_source_sample",
        "update_count",
        "maximum_level",
        "baseline_level",
        "latest_level",
        "baseline_message",
        "latest_message",
        "window_sec",
        "latest_age_sec",
        "input_rate_hz",
        "output_rate_hz",
        "baseline",
        "latest",
        "delta"
      ],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "status_name": {"type": "string", "minLength": 1},
        "source_topic_role": {"type": "string", "minLength": 1},
        "latest_source_sample": {
          "oneOf": [
            {"$ref": "#/$defs/topic_sample"},
            {"type": "null"}
          ]
        },
        "update_count": {"type": "integer", "minimum": 1},
        "maximum_level": {"type": "integer", "minimum": 0, "maximum": 3},
        "baseline_level": {"type": "integer", "minimum": 0, "maximum": 3},
        "latest_level": {"type": "integer", "minimum": 0, "maximum": 3},
        "baseline_message": {"type": "string"},
        "latest_message": {"type": "string"},
        "window_sec": {"type": "number", "minimum": 0},
        "latest_age_sec": {"type": "number", "minimum": 0},
        "input_rate_hz": {"type": "number", "minimum": 0},
        "output_rate_hz": {"type": "number", "minimum": 0},
        "baseline": {"$ref": "#/$defs/diagnostic_snapshot"},
        "latest": {"$ref": "#/$defs/diagnostic_snapshot"},
        "delta": {"$ref": "#/$defs/diagnostic_delta"}
      }
    }
  }
}
