<!-- Responsibility: Model the fixed calibrated stereo camera rig mounted above
     the Gazebo table. -->
<sdf version="1.10">
  <model name="table_camera">
    <static>true</static>
    <link name="table_camera_link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="camera_body_visual">
        <!-- Смещаем корпус назад и чуть укорачиваем по оси X,
             чтобы передняя кромка не попадала в кадр стереосенсоров. -->
        <pose>-0.05 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 0.04 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Левая камера стереопары; baseline формируется разносом по Y на +0.03 м. -->
      <sensor name="table_stereo_left_camera" type="camera">
        <pose>0 0.03 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>/table_stereo/left/image_raw</topic>
        <gz_frame_id>table_stereo_left_optical_frame</gz_frame_id>
        <camera name="table_stereo_left_sensor">
          <camera_info_topic>/table_stereo/left/camera_info</camera_info_topic>
          <horizontal_fov>1.5707963268</horizontal_fov>
          <image>
            <width>960</width>
            <height>576</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>

      <!-- Правая камера стереопары; общий baseline ~0.06 м как у типичных стереокамер. -->
      <sensor name="table_stereo_right_camera" type="camera">
        <pose>0 -0.03 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>/table_stereo/right/image_raw</topic>
        <gz_frame_id>table_stereo_right_optical_frame</gz_frame_id>
        <camera name="table_stereo_right_sensor">
          <camera_info_topic>/table_stereo/right/camera_info</camera_info_topic>
          <horizontal_fov>1.5707963268</horizontal_fov>
          <image>
            <width>960</width>
            <height>576</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
