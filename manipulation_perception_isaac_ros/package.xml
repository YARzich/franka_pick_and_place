<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Responsibility: Declare the optional versioned Isaac ROS dependency bundle. -->
<package format="3">
  <name>manipulation_perception_isaac_ros</name>
  <version>0.1.0</version>
  <description>
    Optional versioned Isaac ROS ESS and FoundationPose bundle for manipulation perception.
  </description>
  <maintainer email="yaric002@gmail.com">Yaroslav</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>manipulation_perception</exec_depend>
  <exec_depend version_gte="4.1.0" version_lt="4.2.0">isaac_ros_ess</exec_depend>
  <exec_depend version_gte="4.1.0" version_lt="4.2.0">isaac_ros_foundationpose</exec_depend>
  <exec_depend version_gte="4.1.0" version_lt="4.2.0">isaac_ros_image_proc</exec_depend>
  <exec_depend version_gte="4.1.0" version_lt="4.2.0">isaac_ros_stereo_image_proc</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
